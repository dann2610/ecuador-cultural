# Copie este archivo como .env y complete los valores. Nunca suba .env a Git.

# --- Django ---
DJANGO_DEBUG=True
# Genere una clave con: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambie-esta-clave
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# En producción con HTTPS: DJANGO_SECURE_COOKIES=True y DJANGO_SSL_REDIRECT=True
DJANGO_SECURE_COOKIES=False

# --- PostgreSQL ---
DB_NAME=ecuador_cultural
DB_USER=ecuador
DB_PASSWORD=escriba-aqui-su-contraseña
DB_HOST=localhost
DB_PORT=5432

# --- Archivos ---
MAX_UPLOAD_SIZE_MB=5

# --- Correo (recuperación de contraseña). Por defecto se imprime en la consola. ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Ecuador Cultural <no-reply@ecuadorcultural.local>
SITE_CONTACT_EMAIL=

# --- Chatbot (opcional). Sin clave funciona con reglas sobre la base de datos. ---
CHATBOT_AI_API_KEY=
CHATBOT_AI_MODEL=claude-haiku-5-5
CHATBOT_AI_URL=https://api.anthropic.com/v1/messages
CHATBOT_RATE_LIMIT_PER_MINUTE=20
